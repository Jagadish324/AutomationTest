<div style="display:flex;align-items:center;justify-content:center;min-height:60vh;">
  <div style="text-align:center;max-width:420px;">
    <div style="font-size:72px;margin-bottom:16px;">&#128683;</div>
    <h1 style="font-size:28px;font-weight:700;margin-bottom:8px;color:var(--text-dark);">Access Denied</h1>
    <p style="font-size:14px;color:var(--text-muted);margin-bottom:24px;">
      You don't have permission to access this page.
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        Your current role is <strong><%= currentUser.role %></strong>.
      <% } %>
    </p>
    <div style="display:flex;gap:10px;justify-content:center;">
      <a href="/" class="btn btn-primary">&#8592; Go to Dashboard</a>
      <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </div>
  </div>
</div>
