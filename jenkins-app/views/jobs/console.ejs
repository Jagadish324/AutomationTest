<div class="page-header">
  <div>
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:4px;">
      <a href="/jobs" style="color:var(--info);">Jobs</a> /
      <a href="/jobs/<%= encodeURIComponent(name) %>" style="color:var(--info);"><%= name %></a> /
      Build #<%= num %> / Console
    </div>
    <div class="page-title">Console Output</div>
    <div class="page-subtitle"><%= name %> — Build #<%= num %></div>
  </div>
  <div class="header-actions">
    <a href="/jobs/<%= encodeURIComponent(name) %>" class="btn btn-secondary">&#8592; Back to Job</a>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">&#128196; Build #<%= num %> Console</span>
    <button class="btn btn-secondary btn-sm" onclick="document.getElementById('console').scrollTop = document.getElementById('console').scrollHeight;">
      &#8595; Scroll to End
    </button>
  </div>
  <pre id="console" style="background:#1e1e1e;color:#d4d4d4;font-family:monospace;font-size:12px;
       padding:20px;margin:0;max-height:600px;overflow-y:auto;white-space:pre-wrap;line-height:1.6;"><%= output %></pre>
</div>

<script>
  // Auto-scroll to bottom on load
  const el = document.getElementById('console');
  el.scrollTop = el.scrollHeight;
</script>
