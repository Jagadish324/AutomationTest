<% const isEdit = !!(job && job.buildNumber !== undefined); %>

<div class="page-header">
  <div>
    <!-- Breadcrumb -->
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:4px;">
      <a href="/jobs" style="color:var(--info);">Jobs</a>
      <% (breadcrumb || []).forEach((crumb, i) => { %>
        <span style="margin:0 4px;">›</span>
        <% if (i < breadcrumb.length - 1) { %>
          <a href="/jobs/<%= crumb.path.split('/').map(encodeURIComponent).join('/') %>" style="color:var(--info);"><%= crumb.name %></a>
        <% } else { %>
          <span><%= crumb.name %></span>
        <% } %>
      <% }); %>
      <% if (breadcrumb && breadcrumb.length) { %><span style="margin:0 4px;">›</span><% } %>
      <span><%= isEdit ? 'Edit' : 'New Job' %></span>
    </div>
    <div class="page-title"><%= isEdit ? 'Edit: ' + job.name : 'Create New Job' %></div>
    <% if (folder) { %>
    <div class="page-subtitle" style="font-size:12px;">
      Inside folder: <span style="font-family:monospace;color:var(--info);"><%= folder %></span>
    </div>
    <% } %>
  </div>
  <a href="<%= folder ? '/jobs/' + folder.split('/').map(encodeURIComponent).join('/') : '/jobs' %>" class="btn btn-secondary">&#8592; Cancel</a>
</div>

<div class="card" style="max-width:720px;">
  <div class="card-body">
    <form method="POST" action="<%= action %>">

      <!-- Hidden folder context -->
      <input type="hidden" name="folder" value="<%= folder || '' %>" />

      <!-- Job Name (readonly on edit) -->
      <div class="form-group">
        <label class="form-label">Job Name <span class="required">*</span></label>
        <input type="text" name="name" class="form-control"
               value="<%= job ? job.name : '' %>"
               placeholder="e.g. my-app-build"
               <%= isEdit ? 'readonly style="background:#f5f5f5;"' : '' %>
               required />
        <div class="form-hint">Lowercase letters, numbers and hyphens. Cannot be changed after creation.</div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Job Type <span class="required">*</span></label>
          <select name="type" class="form-control">
            <% ['Freestyle','Pipeline','Multibranch','Maven','Folder'].forEach(t => { %>
            <option value="<%= t %>" <%= (job && job.type===t)?'selected':'' %>><%= t %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Build Trigger</label>
          <select name="trigger" class="form-control">
            <% ['Manual','SCM Poll','Webhook','Scheduled','Upstream'].forEach(t => { %>
            <option value="<%= t %>" <%= (job && job.trigger===t)?'selected':'' %>><%= t %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="2"
                  placeholder="Brief description…"><%= job ? job.description : '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">SCM Repository URL</label>
          <input type="text" name="repo" class="form-control"
                 value="<%= job ? (job.repo||'') : '' %>"
                 placeholder="https://github.com/org/repo.git" />
        </div>
        <div class="form-group">
          <label class="form-label">Branch</label>
          <input type="text" name="branch" class="form-control"
                 value="<%= job ? (job.branch||'main') : 'main' %>"
                 placeholder="main" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Build Tool</label>
          <select name="buildTool" class="form-control">
            <% ['Maven','Gradle','npm','Make','Ant','Shell'].forEach(t => { %>
            <option value="<%= t %>" <%= (job && job.buildTool===t)?'selected':'' %>><%= t %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Node / Agent Label</label>
          <input type="text" name="node" class="form-control"
                 value="<%= job ? (job.node||'') : '' %>"
                 placeholder="built-in" />
        </div>
      </div>

      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;">
          <input type="checkbox" name="notifyEmail" value="1"
                 <%= (job && job.notifyEmail) ? 'checked' : '' %> />
          Enable email notifications on failure
        </label>
      </div>

      <div class="modal-footer" style="border:none;padding:16px 0 0;justify-content:flex-end;">
        <a href="<%= folder ? '/jobs/' + folder.split('/').map(encodeURIComponent).join('/') : '/jobs' %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">
          &#10003; <%= isEdit ? 'Save Changes' : 'Create Job' %>
        </button>
      </div>
    </form>
  </div>
</div>
