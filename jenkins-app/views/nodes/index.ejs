<!-- Page Header -->
<div class="page-header">
  <div>
    <div class="page-title">Nodes</div>
    <div class="page-subtitle">Build agents &amp; executor status</div>
  </div>
  <div class="header-actions">
    <a href="/nodes" class="btn btn-secondary">&#8635; Refresh</a>
  </div>
</div>

<% if (!configured) { %>
<div class="alert alert-warning" style="margin-bottom:20px;">
  <span class="alert-icon">&#9888;</span>
  Jenkins is not connected.
  <a href="/settings" style="font-weight:700; margin-left:8px;">Configure connection &rarr;</a>
  <button class="alert-close" onclick="this.parentElement.remove()">&#10005;</button>
</div>
<% } %>

<!-- Stat Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon blue">&#128421;</div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.total %></div>
      <div class="stat-label">Total Nodes</div>
      <div class="stat-change up"><%= stats.executorTotal %> total executors</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon green">&#9679;</div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.online %></div>
      <div class="stat-label">Online</div>
      <div class="stat-change up">Available for builds</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon red">&#9679;</div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.offline %></div>
      <div class="stat-label">Offline</div>
      <div class="stat-change down"><%= stats.offline > 0 ? 'Needs attention' : 'All nodes healthy' %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon orange">&#9654;</div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.busy %></div>
      <div class="stat-label">Busy Executors</div>
      <div class="stat-change" style="color:var(--info);"><%= stats.executorTotal - stats.busy %> idle</div>
    </div>
  </div>
</div>

<!-- Nodes Table -->
<div class="card">
  <div class="card-header">
    <span class="card-title">All Nodes <span style="font-size:13px;font-weight:400;color:var(--text-muted);margin-left:6px;">(<%= nodes.length %>)</span></span>
  </div>
  <div class="table-container">
    <% if (nodes.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">&#128421;</div>
        <p><% if (configured) { %>No nodes found.<% } else { %>Connect Jenkins to see nodes.<% } %></p>
      </div>
    <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Node</th>
          <th>Status</th>
          <th>Executors</th>
          <th>Load</th>
          <th>Labels</th>
          <th>Current Builds</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% nodes.forEach(node => { %>
        <tr>
          <td>
            <div class="job-name-cell">
              <div class="job-icon" style="background:<%= node.offline ? '#ffebee' : '#e8f5e9' %>;">
                &#128421;
              </div>
              <div>
                <a href="/nodes/<%= encodeURIComponent(node.name) %>" class="job-name"><%= node.name %></a>
                <% if (node.description) { %>
                <div class="job-desc"><%= node.description.substring(0, 60) %></div>
                <% } %>
              </div>
            </div>
          </td>
          <td>
            <% if (node.offline) { %>
              <span class="status-badge failed">&#9679; Offline</span>
              <% if (node.offlineCause) { %>
              <div style="font-size:11px;color:var(--text-muted);margin-top:3px;max-width:160px;word-break:break-word;"><%= node.offlineCause.substring(0, 60) %></div>
              <% } %>
            <% } else if (node.busy > 0) { %>
              <span class="status-badge running">&#9679; Building</span>
            <% } else { %>
              <span class="status-badge success">&#9679; Idle</span>
            <% } %>
          </td>
          <td>
            <span style="font-size:13px;font-weight:600;"><%= node.busy %> / <%= node.total %></span>
            <span style="font-size:11px;color:var(--text-muted);"> busy</span>
          </td>
          <td style="min-width:120px;">
            <%- nodeLoadBar(node.load, node.offline) %>
          </td>
          <td style="max-width:200px;">
            <% if (node.labels && node.labels.length > 0) { %>
              <div class="label-chips">
                <% node.labels.slice(0, 4).forEach(lbl => { %>
                  <span class="label-chip"><%= lbl %></span>
                <% }); %>
                <% if (node.labels.length > 4) { %>
                  <span class="label-chip" style="background:#e0e0e0;color:#666;">+<%= node.labels.length - 4 %></span>
                <% } %>
              </div>
            <% } else { %>
              <span style="color:var(--text-muted);font-size:12px;">—</span>
            <% } %>
          </td>
          <td style="max-width:200px;">
            <% if (node.currentBuilds && node.currentBuilds.length > 0) { %>
              <% node.currentBuilds.forEach(b => { %>
                <div style="font-size:12px;color:var(--info);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:190px;" title="<%= b.name %>">
                  &#9654; <%= b.name %>
                </div>
              <% }); %>
            <% } else { %>
              <span style="color:var(--text-muted);font-size:12px;">—</span>
            <% } %>
          </td>
          <td>
            <a href="/nodes/<%= encodeURIComponent(node.name) %>" class="btn-icon btn-sm" title="View Details">&#128269;</a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<% function nodeLoadBar(load, offline) {
  if (offline) return `<div style="display:flex;align-items:center;gap:6px;"><div class="progress-bar-container" style="width:80px;"><div class="progress-bar" style="width:0%;background:var(--danger);"></div></div><span style="font-size:11px;color:var(--danger);">Offline</span></div>`;
  const color = load === 0 ? 'var(--success)' : load < 70 ? 'var(--info)' : 'var(--warning)';
  return `<div style="display:flex;align-items:center;gap:6px;">
    <div class="progress-bar-container" style="width:80px;"><div class="progress-bar" style="width:${load}%;background:${color};"></div></div>
    <span style="font-size:11px;color:var(--text-muted);">${load}%</span>
  </div>`;
} %>
