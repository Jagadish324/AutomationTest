<%
  const JenkinsConfig = require('../config/jenkins');
  const configured    = JenkinsConfig.isConfigured();
  const cfg           = JenkinsConfig.getConfig();
  let   hostLabel     = 'Demo Mode';
  if (configured && cfg.url) {
    try { hostLabel = new URL(cfg.url).hostname; } catch(_) { hostLabel = cfg.url; }
  }
%>
<nav class="navbar">
  <div class="navbar-brand">
    <div class="logo-icon">&#9881;</div>
    Jenkins CI
  </div>

  <form class="navbar-search" action="/jobs" method="GET">
    <span class="search-icon">&#128269;</span>
    <input type="text" name="q" placeholder="Search jobs…" value="<%= typeof currentQ !== 'undefined' ? currentQ : '' %>" />
  </form>

  <div class="navbar-actions">
    <!-- Connection status chip -->
    <a href="/settings" class="conn-chip <%= configured ? 'connected' : 'demo' %>" title="Connection settings">
      <span class="conn-dot <%= configured ? 'connected' : 'demo' %>"></span>
      <%= configured ? hostLabel : 'Demo Mode' %>
    </a>

    <a href="/jobs/new" class="icon-btn" title="New Job">&#43;</a>
    <a href="/settings" class="icon-btn" title="Settings">&#9881;</a>
    <div class="user-avatar">AD</div>
  </div>
</nav>
