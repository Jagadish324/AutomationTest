<!-- Page Header -->
<div class="page-header">
  <div>
    <div class="page-title"><%= user ? 'Edit User' : 'New User' %></div>
    <div class="page-subtitle"><%= user ? `Editing ${user.name}` : 'Create a new application user' %></div>
  </div>
  <div class="header-actions">
    <a href="/users" class="btn btn-secondary">&#8592; Back to Users</a>
  </div>
</div>

<div class="card" style="max-width:580px;">
  <div class="card-header">
    <span class="card-title"><%= user ? 'Edit User Details' : 'User Details' %></span>
  </div>
  <div class="card-body">
    <form method="POST" action="<%= user ? `/users/${user.id}?_method=PUT` : '/users' %>">

      <% if (!user) { %>
      <!-- Username — only set on create -->
      <div class="form-group">
        <label class="form-label" for="username">Username <span class="required">*</span></label>
        <input id="username" name="username" type="text" class="form-control"
               placeholder="e.g. john.doe" required autocomplete="off" />
        <div class="form-hint">Used to sign in. Cannot be changed after creation.</div>
      </div>
      <% } else { %>
      <div class="form-group">
        <label class="form-label">Username</label>
        <div class="form-control" style="background:#f8f9fa;color:var(--text-muted);cursor:default;">
          <%= user.username %>
        </div>
      </div>
      <% } %>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="name">Full Name</label>
          <input id="name" name="name" type="text" class="form-control"
                 value="<%= user ? user.name : '' %>" placeholder="e.g. John Doe" />
        </div>
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input id="email" name="email" type="email" class="form-control"
                 value="<%= user ? user.email : '' %>" placeholder="e.g. john@example.com" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">
          Password <% if (user) { %><span style="font-weight:400;color:var(--text-muted);">(leave blank to keep current)</span><% } else { %><span class="required">*</span><% } %>
        </label>
        <input id="password" name="password" type="password" class="form-control"
               placeholder="<%= user ? 'Leave blank to keep current password' : 'Enter a strong password' %>"
               <%= user ? '' : 'required' %> autocomplete="new-password" />
        <div class="form-hint">Minimum 6 characters recommended.</div>
      </div>

      <div class="form-group">
        <label class="form-label" for="role">Role <span class="required">*</span></label>
        <select id="role" name="role" class="form-control" required>
          <% roles.forEach(r => { %>
          <option value="<%= r %>" <%= (user && user.role === r) ? 'selected' : '' %>>
            <%= r.charAt(0).toUpperCase() + r.slice(1) %>
            <% if (r === 'admin') { %> — Full access<% } %>
            <% if (r === 'developer') { %> — Create/edit/build jobs<% } %>
            <% if (r === 'viewer') { %> — Read-only<% } %>
          </option>
          <% }); %>
        </select>
        <div class="form-hint">
          <strong>Admin:</strong> all permissions &bull;
          <strong>Developer:</strong> create/edit/trigger jobs, no settings &bull;
          <strong>Viewer:</strong> read-only access
        </div>
      </div>

      <div class="modal-footer">
        <a href="/users" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">
          <%= user ? '&#10003; Save Changes' : '&#43; Create User' %>
        </button>
      </div>

    </form>
  </div>
</div>
